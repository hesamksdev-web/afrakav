# Copy to .env on the server and fill in real values:  cp .env.example .env
# .env is gitignored — it must never be committed.
#
# Generate secrets with:
#   openssl rand -base64 24 | tr -d '/+=@:'
# Avoid / + @ : characters — POSTGRES_PASSWORD is embedded in a DSN URL.
# JWT_SECRET must be at least 32 characters and ADMIN_PASSWORD at least 12,
# or the backend refuses to start / refuses to create the admin.

POSTGRES_USER=afrashodan
POSTGRES_DB=afrashodan
POSTGRES_PASSWORD=

JWT_SECRET=

ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional demo customer seeded with the bundled sample scan on first boot.
# Leave empty in production.
DEMO_USER=
DEMO_PASSWORD=
